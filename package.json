{
  "name": "@dotbugi/mcp",
  "version": "0.3.0",
  "description": "한성대학교 LMS(learn.hansung.ac.kr) VOD·과제·퀴즈를 Claude Code / Claude Desktop에서 다루는 MCP 서버",
  "license": "Apache-2.0",
  "author": "6-keem",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hs-shell/dotbugi-mcp.git"
  },
  "bugs": "https://github.com/hs-shell/dotbugi-mcp/issues",
  "homepage": "https://github.com/hs-shell/dotbugi-mcp#readme",
  "type": "module",
  "bin": {
    "dotbugi-mcp": "dist/index.js"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=22.22.1"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "rm -rf dist && tsc --noEmit && tsc -p tsconfig.build.json && cp src/asr/gpu_transcribe.py src/asr/gpu-requirements.txt dist/asr/",
    "start": "node dist/index.js",
    "inspect": "npx @modelcontextprotocol/inspector@2.12.0 node dist/index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "format": "prettier --write .",
    "prepare": "husky",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "@dotbugi/lms-parser": "^0.1.1",
    "@modelcontextprotocol/server": "^2.3.1",
    "@napi-rs/keyring": "^2.1.2",
    "cfb": "^1.2.2",
    "linkedom": "^0.18.14",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@eslint/js": "^9.39.5",
    "@types/node": "^26.6.5",
    "eslint": "^9.39.5",
    "globals": "^17.13.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "prettier": "^3.9.10",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.0",
    "vitest": "^5.0.5"
  },
  "lint-staged": {
    "*.{ts,js}": [
      "prettier --write",
      "eslint --fix"
    ],
    "*.{json,md,yml,yaml}": [
      "prettier --write"
    ]
  }
}
