{
  "name": "dotbugi-mcp",
  "version": "0.1.0",
  "scripts": {
    "build": "rm -rf dist && tsc --noEmit && tsc -p tsconfig.build.json",
    "start": "node dist/index.js",
    "inspect": "npx @modelcontextprotocol/inspector@2.12.0 node dist/index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "format": "prettier --write .",
    "prepare": "husky"
  },
  "license": "UNLICENSED",
  "type": "module",
  "dependencies": {
    "@modelcontextprotocol/server": "^2.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@eslint/js": "^9.39.5",
    "@types/node": "^26.6.5",
    "eslint": "^9.39.5",
    "globals": "^17.13.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "prettier": "^3.9.10",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.0",
    "vitest": "^5.0.5"
  },
  "private": true,
  "bin": {
    "dotbugi-mcp": "dist/index.js"
  },
  "engines": {
    "node": ">=22.22.1"
  },
  "lint-staged": {
    "*.{ts,js}": [
      "prettier --write",
      "eslint --fix"
    ],
    "*.{json,md,yml,yaml}": [
      "prettier --write"
    ]
  }
}
